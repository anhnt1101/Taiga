{
  "name": "@taiga-ui/design-tokens",
  "version": "0.312.0",
  "description": "Taiga UI palette",
  "keywords": [
    "angular",
    "palette"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./angular/*": "./angular/*",
    "./fonts/*": "./fonts/*",
    "./palette/*": "./palette/*",
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "esm2022": "./esm2022/taiga-ui-design-tokens.mjs",
      "esm": "./esm2022/taiga-ui-design-tokens.mjs",
      "default": "./fesm2022/taiga-ui-design-tokens.mjs"
    }
  },
  "license": "Apache-2.0",
  "module": "fesm2022/taiga-ui-design-tokens.mjs",
  "typings": "index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "tslib": "^2.3.0"
  }
}